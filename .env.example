DATABASE_URL="mysql://usms:usms@127.0.0.1:3306/usms_admission"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-at-least-32-random-characters"
COOKIE_SECURE=false
VITE_API_URL="http://localhost:4000/api"

# cPanel SMTP (leave unset locally to skip email and show temporary password once)
# SMTP_HOST=mail.usms.edu.pk
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admissions@usms.edu.pk
# SMTP_PASS=
MAIL_FROM=admissions@usms.edu.pk

# Private document storage (outside web roots on cPanel)
# UPLOADS_DIR=/home/usmsedu/apps/usms-admission/storage/uploads

# Production same-origin: serve client/dist from Express
# CLIENT_DIST_DIR=/home/usmsedu/apps/usms-admission/client/dist
# CLIENT_ORIGIN=https://admissions.usms.edu.pk
# COOKIE_SECURE=true
# VITE_API_URL=/api
