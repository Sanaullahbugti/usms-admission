generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGE_REQUESTED
  RESUBMITTED
  DOCUMENTS_VERIFIED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum AdmissionCycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  loginId      String?       @unique
  phone        String?
  passwordHash String
  isActive     Boolean       @default(true)
  applications Application[]
  roles        UserRole[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdmissionCycle {
  id                String               @id @default(uuid())
  name              String
  academicYear      String
  applicationPrefix String
  status            AdmissionCycleStatus @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  applications      Application[]
  offerings         ProgramOffering[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Program {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  degreeType    String?
  durationYears Decimal?          @db.Decimal(3, 1)
  department    String?
  isActive      Boolean           @default(true)
  offerings     ProgramOffering[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ProgramOffering {
  id                    String                     @id @default(uuid())
  admissionCycleId      String
  programId             String
  minimumPercentage     Decimal?                   @db.Decimal(5, 2)
  minimumEducationYears Int?
  availableSeats        Int?
  applicationFee        Decimal?                   @db.Decimal(10, 2)
  isOpen                Boolean                    @default(false)
  admissionCycle        AdmissionCycle             @relation(fields: [admissionCycleId], references: [id])
  program               Program                    @relation(fields: [programId], references: [id])
  choices               ApplicationProgramChoice[]

  @@unique([admissionCycleId, programId])
}

model Application {
  id               String                     @id @default(uuid())
  applicationNo    String?                    @unique
  userId           String
  admissionCycleId String
  status           ApplicationStatus          @default(DRAFT)
  paymentStatus    PaymentStatus              @default(PENDING)
  version          Int                        @default(1)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  user             User                       @relation(fields: [userId], references: [id])
  admissionCycle   AdmissionCycle             @relation(fields: [admissionCycleId], references: [id])
  profile          ApplicantProfile?
  programChoices   ApplicationProgramChoice[]
  education        ApplicationEducation[]
  reviews          ApplicationReview[]
  documents        ApplicationDocument[]

  @@unique([userId, admissionCycleId])
  @@index([admissionCycleId, status])
  @@index([userId])
}

model ApplicationDocument {
  id            String         @id @default(uuid())
  applicationId String
  docType       String         @db.VarChar(40)
  originalName  String         @db.VarChar(255)
  mimeType      String         @db.VarChar(120)
  sizeBytes     Int
  storageKey    String         @db.VarChar(500)
  status        DocumentStatus @default(UPLOADED)
  uploadedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, docType])
  @@index([applicationId])
}

model ApplicationReview {
  id            String      @id @default(uuid())
  applicationId String
  reviewerId    String?
  action        String
  message       String?     @db.Text
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicantProfile {
  id                 String      @id @default(uuid())
  applicationId      String      @unique
  applicantName      String      @db.VarChar(120)
  fatherName         String      @db.VarChar(120)
  guardianName       String?     @db.VarChar(120)
  surname            String?     @db.VarChar(120)
  gender             String?     @db.VarChar(20)
  fatherOccupation   String?     @db.VarChar(120)
  mobile             String?     @db.VarChar(20)
  domicileDistrict   String?     @db.VarChar(80)
  nationality        String?     @db.VarChar(80)
  dateOfBirth        DateTime?
  email              String?     @db.VarChar(191)
  province           String?     @db.VarChar(80)
  cnicBform          String?     @db.VarChar(20)
  postalAddress      String?     @db.VarChar(300)
  residentialAddress String?     @db.VarChar(300)
  householdIncome    String?     @db.VarChar(120)
  emergencyContact   String?     @db.VarChar(160)
  emergencyPhone     String?     @db.VarChar(20)
  hasSibling         Boolean     @default(false)
  siblingName        String?     @db.VarChar(120)
  siblingRegNo       String?     @db.VarChar(60)
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationEducation {
  id              String      @id @default(uuid())
  applicationId   String
  level           String      @db.VarChar(20)
  group           String?     @db.VarChar(80)
  board           String?     @db.VarChar(120)
  year            String?     @db.VarChar(10)
  obtainedMarks   String?     @db.VarChar(20)
  totalMarks      String?     @db.VarChar(20)
  cgpa            String?     @db.VarChar(20)
  rollNumber      String?     @db.VarChar(60)
  institutionType String?     @db.VarChar(80)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, level])
  @@index([applicationId])
}

model ApplicationProgramChoice {
  id                String          @id @default(uuid())
  applicationId     String
  programOfferingId String
  preferenceOrder   Int
  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programOffering   ProgramOffering @relation(fields: [programOfferingId], references: [id])

  @@unique([applicationId, preferenceOrder])
  @@index([applicationId])
  @@index([programOfferingId])
}
