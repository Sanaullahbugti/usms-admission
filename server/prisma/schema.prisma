generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGE_REQUESTED
  RESUBMITTED
  DOCUMENTS_VERIFIED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum AdmissionCycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String?
  passwordHash String
  isActive     Boolean       @default(true)
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AdmissionCycle {
  id            String               @id @default(uuid())
  name          String
  academicYear  String
  status        AdmissionCycleStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  applications Application[]
  offerings     ProgramOffering[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Program {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  isActive  Boolean           @default(true)
  offerings ProgramOffering[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProgramOffering {
  id                String         @id @default(uuid())
  admissionCycleId  String
  programId         String
  minimumPercentage Decimal?       @db.Decimal(5, 2)
  availableSeats    Int?
  applicationFee    Decimal?       @db.Decimal(10, 2)
  isOpen            Boolean        @default(false)
  admissionCycle    AdmissionCycle @relation(fields: [admissionCycleId], references: [id])
  program           Program        @relation(fields: [programId], references: [id])
  choices           ApplicationProgramChoice[]

  @@unique([admissionCycleId, programId])
}

model Application {
  id               String            @id @default(uuid())
  applicationNo    String?           @unique
  userId           String
  admissionCycleId String
  status           ApplicationStatus @default(DRAFT)
  paymentStatus    PaymentStatus     @default(PENDING)
  version          Int               @default(1)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  admissionCycle   AdmissionCycle    @relation(fields: [admissionCycleId], references: [id])
  profile          ApplicantProfile?
  programChoices   ApplicationProgramChoice[]

  @@index([admissionCycleId, status])
  @@index([userId])
}

model ApplicantProfile {
  id              String      @id @default(uuid())
  applicationId   String      @unique
  applicantName   String
  fatherName      String
  guardianName    String?
  surname         String?
  gender          String?
  fatherOccupation String?
  mobile          String?
  domicileDistrict String?
  nationality     String?
  dateOfBirth     DateTime?
  email           String?
  province        String?
  cnicBform       String?
  postalAddress   String?
  residentialAddress String?
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationProgramChoice {
  id                String          @id @default(uuid())
  applicationId     String
  programOfferingId String
  preferenceOrder   Int
  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programOffering   ProgramOffering @relation(fields: [programOfferingId], references: [id])

  @@unique([applicationId, preferenceOrder])
  @@unique([applicationId, programOfferingId])
}
